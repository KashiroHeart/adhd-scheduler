<Window x:Class="AdhdScheduler.App.Views.PlanningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="計画"
        Width="960"
        Height="640"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 目標 -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="目標" FontWeight="Bold" Margin="0,0,0,4" />

            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock Text="選択中の目標" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding EditGoalTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" />
                <WrapPanel>
                    <Button Content="名前を変更" Command="{Binding RenameGoalCommand}" Margin="0,0,8,4" />
                    <Button Content="取り組む目標にする" Command="{Binding SetActiveGoalCommand}" Margin="0,0,8,4" />
                    <Button Content="削除" Command="{Binding DeleteGoalCommand}" Margin="0,0,8,4" />
                </WrapPanel>

                <TextBlock Text="新しい目標" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                <DockPanel Margin="0,2,0,0">
                    <Button DockPanel.Dock="Right" Content="追加" Command="{Binding AddGoalCommand}" />
                    <TextBox Text="{Binding NewGoalTitle, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </StackPanel>

            <ListBox ItemsSource="{Binding Goals}" SelectedItem="{Binding SelectedGoal}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="● "
                                       Foreground="#2E9E5B"
                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Title}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 1手 -->
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="1手（上から順に実行）" FontWeight="Bold" Margin="0,0,0,4" />

            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock Text="目的" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding EditPurpose, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MultiLineInput}" />
                <TextBlock Text="理由" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding EditReason, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MultiLineInput}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="末尾に追加" Command="{Binding AppendStepCommand}" />
                    <Button Content="変更を保存" Command="{Binding SaveStepCommand}" />
                    <Button Content="選択を解除" Command="{Binding ClearEditorCommand}" />
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                <Button Content="↑" Command="{Binding MoveStepUpCommand}" Margin="0,0,0,4" />
                <Button Content="↓" Command="{Binding MoveStepDownCommand}" Margin="0,0,0,12" />
                <Button Content="削除" Command="{Binding DeleteStepCommand}" Margin="0" />
            </StackPanel>

            <ListBox ItemsSource="{Binding Steps}"
                     SelectedItem="{Binding SelectedStep}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Number, StringFormat={}{0}.}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Purpose}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Reason}" Foreground="#666666" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Button Grid.Row="1"
                Grid.Column="0"
                Content="後でやる一覧"
                Command="{Binding OpenLaterListCommand}"
                HorizontalAlignment="Left"
                Margin="0,12,0,0" />
    </Grid>
</Window>
