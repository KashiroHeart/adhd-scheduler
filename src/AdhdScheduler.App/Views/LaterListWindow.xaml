<Window x:Class="AdhdScheduler.App.Views.LaterListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="後でやる一覧"
        Width="600"
        Height="520"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <!-- タスク化の入力欄 -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="#CCCCCC"
                BorderThickness="0,1,0,0"
                Padding="0,8,0,0"
                Margin="0,8,0,0"
                Visibility="{Binding IsTaskifying, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding TaskifyTarget.Text}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="目標" Style="{StaticResource Caption}" />
                <ComboBox ItemsSource="{Binding Goals}"
                          SelectedItem="{Binding TaskifyGoal}"
                          DisplayMemberPath="Title"
                          Margin="0,2,0,8" />
                <TextBlock Text="目的" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding TaskifyPurpose, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MultiLineInput}" />
                <TextBlock Text="理由" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding TaskifyReason, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MultiLineInput}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="確定" Command="{Binding ConfirmTaskifyCommand}" />
                    <Button Content="キャンセル" Command="{Binding CancelTaskifyCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ListBox ItemsSource="{Binding Items}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="タスク化"
                                    Command="{Binding DataContext.BeginTaskifyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="削除"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
